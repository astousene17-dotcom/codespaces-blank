<section class="email-signup">
  <div class="email-signup__inner">
    <span class="email-signup__label">{{ section.settings.label }}</span>
    <h2 class="email-signup__title">{{ section.settings.heading }}</h2>
    <p class="email-signup__subtitle">{{ section.settings.subheading }}</p>

    {% form 'customer', class: 'email-form', id: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter,senashaps-club">
      <label class="visually-hidden" for="newsletter-email">{{ section.settings.placeholder }}</label>
      <input
        class="email-form__input"
        type="email"
        id="newsletter-email"
        name="contact[email]"
        placeholder="{{ section.settings.placeholder }}"
        required
        autocomplete="email"
      >
      <button type="submit" class="email-form__btn">
        {{ section.settings.button_text }}
      </button>
    {% endform %}

    <p class="email-signup__disclaimer">{{ section.settings.disclaimer }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Email Signup",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Exclusive Offer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Senashaps Confidence Club"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get 10% off your first order plus early access to new drops and members-only offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Claim 10% Off"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "By subscribing you agree to our Privacy Policy. Unsubscribe anytime."
    }
  ],
  "presets": [
    { "name": "Email Signup" }
  ]
}
{% endschema %}
