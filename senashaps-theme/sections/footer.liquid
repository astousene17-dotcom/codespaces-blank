<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-top">

      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="footer-logo">{{ shop.name }}</a>
        <p class="footer-tagline">{{ section.settings.tagline }}</p>
        <div class="footer-social">
          {% if section.settings.instagram_url != blank %}
            <a href="{{ section.settings.instagram_url }}" class="footer-social__link" aria-label="Follow us on Instagram" target="_blank" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.tiktok_url != blank %}
            <a href="{{ section.settings.tiktok_url }}" class="footer-social__link" aria-label="Follow us on TikTok" target="_blank" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.19 8.19 0 0 0 4.79 1.52V6.76a4.85 4.85 0 0 1-1.02-.07z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.facebook_url != blank %}
            <a href="{{ section.settings.facebook_url }}" class="footer-social__link" aria-label="Follow us on Facebook" target="_blank" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </a>
          {% endif %}
          {% if section.settings.pinterest_url != blank %}
            <a href="{{ section.settings.pinterest_url }}" class="footer-social__link" aria-label="Follow us on Pinterest" target="_blank" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Shop Column -->
      <div class="footer-col">
        <h3 class="footer-col__heading">Shop</h3>
        <ul class="footer-links">
          <li><a href="/collections/all" class="footer-link">Shop All</a></li>
          <li><a href="/collections/bodysuits" class="footer-link">Shapewear Bodysuits</a></li>
          <li><a href="/collections/bras" class="footer-link">Seamless Bras</a></li>
          <li><a href="/collections/underwear" class="footer-link">Seamless Underwear</a></li>
          <li><a href="/collections/sculpting-shorts" class="footer-link">Sculpting Shorts</a></li>
          <li><a href="/collections/sets" class="footer-link">Matching Sets</a></li>
          <li><a href="/collections/best-sellers" class="footer-link">Best Sellers</a></li>
        </ul>
      </div>

      <!-- Help Column -->
      <div class="footer-col">
        <h3 class="footer-col__heading">Help</h3>
        <ul class="footer-links">
          <li><a href="/pages/size-guide" class="footer-link">Size Guide</a></li>
          <li><a href="/pages/faq" class="footer-link">FAQ</a></li>
          <li><a href="/pages/shipping-policy" class="footer-link">Shipping Policy</a></li>
          <li><a href="/pages/return-policy" class="footer-link">Return Policy</a></li>
          <li><a href="/pages/contact" class="footer-link">Contact Us</a></li>
        </ul>
      </div>

      <!-- Company Column -->
      <div class="footer-col">
        <h3 class="footer-col__heading">Company</h3>
        <ul class="footer-links">
          <li><a href="/pages/about" class="footer-link">About Senashaps</a></li>
          <li><a href="/blogs/news" class="footer-link">Style Journal</a></li>
          <li><a href="/pages/affiliate" class="footer-link">Affiliate Program</a></li>
          <li><a href="/pages/privacy-policy" class="footer-link">Privacy Policy</a></li>
          <li><a href="/pages/terms-of-service" class="footer-link">Terms of Service</a></li>
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <p class="footer-payments">Visa &middot; Mastercard &middot; Amex &middot; PayPal &middot; Shop Pay &middot; Afterpay</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Premium shaping essentials for every woman. Smooth, support, and celebrate every curve."
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    }
  ]
}
{% endschema %}
