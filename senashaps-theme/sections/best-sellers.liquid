<section class="best-sellers section-pad">
  <div class="container">
    <div class="best-sellers__header">
      <span class="section-label">{{ section.settings.label }}</span>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="section-subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="best-sellers__grid">
      {% assign feat_collection = collections[section.settings.collection] %}
      {% if feat_collection != empty and feat_collection.products.size > 0 %}
        {% for product in feat_collection.products limit: 4 %}
          {% render 'product-card', product: product, badge: 'Best Seller' %}
        {% endfor %}
      {% else %}
        <!-- Fallback static blocks when no collection is assigned -->
        {% for block in section.blocks %}
          <div class="product-card" {{ block.shopify_attributes }}>
            <div class="product-card__image-wrap">
              {% if block.settings.image != blank %}
                <img
                  class="product-card__image"
                  src="{{ block.settings.image | img_url: '600x800', crop: 'center' }}"
                  alt="{{ block.settings.title }}"
                  loading="lazy" width="300" height="400"
                >
              {% else %}
                <div style="width:100%;height:100%;background:linear-gradient(160deg,var(--color-beige),var(--color-sand));"></div>
              {% endif %}
              <span class="product-card__badge">Best Seller</span>
              <div class="product-card__quick-add">
                <button class="btn btn-light btn-full" style="padding:.625rem 1rem;font-size:.8125rem;">Quick Add</button>
              </div>
            </div>
            <div class="product-card__info">
              <span class="product-card__category">{{ block.settings.category }}</span>
              <h3 class="product-card__title">{{ block.settings.title }}</h3>
              <div class="product-card__swatches">
                <span class="swatch swatch--black" title="Black"></span>
                <span class="swatch swatch--nude"  title="Nude"></span>
                <span class="swatch swatch--dark-nude" title="Dark Nude"></span>
                <span class="swatch swatch--brown" title="Brown"></span>
              </div>
              <div class="product-card__price">{{ block.settings.price }}</div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.button_text != blank %}
      <div class="text-center" style="margin-top:var(--sp-xl);">
        <a href="{{ section.settings.button_url | default: '/collections/best-sellers' }}" class="btn btn-secondary">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Best Sellers",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Fan Favorites"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our most-loved shaping essentials, trusted by thousands of women."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (overrides manual blocks below)"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View All Best Sellers"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Product name",
          "default": "Signature Sculpt Bodysuit"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category label",
          "default": "Shapewear Bodysuit"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price (display only)",
          "default": "$68.00"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Sellers",
      "blocks": [
        { "type": "product", "settings": { "title": "Signature Sculpt Bodysuit", "category": "Shapewear Bodysuit",  "price": "$68.00" } },
        { "type": "product", "settings": { "title": "SmoothFit Seamless Bra",    "category": "Seamless Bras",       "price": "$42.00" } },
        { "type": "product", "settings": { "title": "CurveSoft High-Waist Brief","category": "Seamless Underwear",  "price": "$36.00" } },
        { "type": "product", "settings": { "title": "Everyday Confidence Set",   "category": "Matching Sets",       "price": "$118.00" } }
      ]
    }
  ]
}
{% endschema %}
