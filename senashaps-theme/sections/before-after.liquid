<section class="before-after section-pad">
  <div class="container">
    <div class="before-after__header">
      <span class="section-label">{{ section.settings.label }}</span>
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      <p class="section-subtitle">{{ section.settings.subheading }}</p>
    </div>

    <div class="before-after__grid">
      {% for block in section.blocks %}
        <div class="ba-card" {{ block.shopify_attributes }}>
          <div class="ba-card__images">
            <div class="ba-card__half">
              {% if block.settings.before_image != blank %}
                <img
                  src="{{ block.settings.before_image | img_url: '400x600', crop: 'center' }}"
                  alt="Before wearing {{ block.settings.outfit }}"
                  loading="lazy" width="200" height="300"
                >
              {% else %}
                <div style="width:100%;height:100%;background:linear-gradient(160deg,#C4956A,#A07355);"></div>
              {% endif %}
              <span class="ba-label ba-label--before">Before</span>
            </div>
            <div class="ba-card__half">
              {% if block.settings.after_image != blank %}
                <img
                  src="{{ block.settings.after_image | img_url: '400x600', crop: 'center' }}"
                  alt="After wearing {{ block.settings.outfit }}"
                  loading="lazy" width="200" height="300"
                >
              {% else %}
                <div style="width:100%;height:100%;background:linear-gradient(160deg,#6B4F3F,#4A3328);"></div>
              {% endif %}
              <span class="ba-label ba-label--after">After</span>
            </div>
            <div class="ba-divider">
              <div class="ba-divider__dot">↔</div>
            </div>
          </div>
          <div class="ba-card__info">
            <div class="ba-card__outfit">{{ block.settings.outfit }}</div>
            <div class="ba-card__desc">{{ block.settings.description }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before & After",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "See the Difference"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Senashaps Effect"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "See how our shaping essentials transform the way your outfits look and feel."
    }
  ],
  "blocks": [
    {
      "type": "comparison",
      "name": "Comparison",
      "settings": [
        {
          "type": "text",
          "id": "outfit",
          "label": "Outfit label",
          "default": "Under a Bodycon Dress"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "The Signature Sculpt Bodysuit creates a perfectly smooth, seamless finish under fitted dresses."
        },
        {
          "type": "image_picker",
          "id": "before_image",
          "label": "Before image"
        },
        {
          "type": "image_picker",
          "id": "after_image",
          "label": "After image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before & After",
      "blocks": [
        {
          "type": "comparison",
          "settings": {
            "outfit": "Under a Bodycon Dress",
            "description": "The Signature Sculpt Bodysuit creates a perfectly smooth, seamless finish under fitted dresses."
          }
        },
        {
          "type": "comparison",
          "settings": {
            "outfit": "Under Tailored Trousers",
            "description": "The CurveSoft High-Waist Brief eliminates visible lines for a clean, polished workwear look."
          }
        },
        {
          "type": "comparison",
          "settings": {
            "outfit": "Under a Silky Blouse",
            "description": "The SmoothFit Seamless Bra provides invisible lift and shape with zero lines or texture."
          }
        }
      ]
    }
  ]
}
{% endschema %}
