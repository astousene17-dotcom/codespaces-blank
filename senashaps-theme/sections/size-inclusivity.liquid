<section class="size-section section-pad">
  <div class="container">
    <div class="size-section__inner">
      <div class="size-section__content">
        <span class="section-label">{{ section.settings.label }}</span>
        <h2 class="size-section__title">{{ section.settings.heading }}</h2>
        <p class="size-section__text">{{ section.settings.text }}</p>

        <div class="size-grid">
          {% assign sizes = section.settings.sizes | split: ',' %}
          {% for sz in sizes %}
            <div class="size-badge">{{ sz | strip }}</div>
          {% endfor %}
        </div>

        <a href="{{ section.settings.guide_url | default: '/pages/size-guide' }}" class="btn btn-secondary">
          View Full Size Guide
        </a>
      </div>

      <div class="size-section__image">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | img_url: '900x1125', crop: 'center' }}"
            alt="{{ section.settings.heading }}"
            loading="lazy" width="450" height="563"
          >
        {% else %}
          <div style="width:100%;height:100%;background:linear-gradient(160deg,var(--color-beige),var(--color-nude));"></div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size Inclusivity",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Inclusive Sizing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for Every Body"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "We believe every woman deserves to feel confident and supported. Senashaps is designed and tested across a full range of sizes — from XS to 3XL — because your confidence has no size limit."
    },
    {
      "type": "text",
      "id": "sizes",
      "label": "Size list (comma-separated)",
      "default": "XS, S, M, L, XL, XXL, 3XL"
    },
    {
      "type": "url",
      "id": "guide_url",
      "label": "Size guide URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section image",
      "info": "Recommended: portrait 900×1125px showing diverse body representation"
    }
  ],
  "presets": [
    { "name": "Size Inclusivity" }
  ]
}
{% endschema %}
