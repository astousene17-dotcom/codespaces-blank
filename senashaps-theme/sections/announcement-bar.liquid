<div class="announcement-bar">
  {{ section.settings.text }}
  {% if section.settings.link != blank %}
    &nbsp;<a href="{{ section.settings.link }}">{{ section.settings.link_text }}</a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Free shipping on orders over $75 · Use code SENASHAPS10 for 10% off your first order"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Shop Now →"
    }
  ],
  "presets": [
    { "name": "Announcement Bar" }
  ]
}
{% endschema %}
